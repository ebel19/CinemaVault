<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Redirect root to home" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="Home.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
